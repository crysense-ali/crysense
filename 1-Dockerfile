FROM python:3.11-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg libsndfile1 unzip && rm -rf /var/lib/apt/lists/*
RUN useradd -m -u 1000 user
USER user
ENV PATH="/home/user/.local/bin:$PATH" PORT=7860
WORKDIR /home/user
COPY --chown=user crysense.zip .
RUN unzip -q crysense.zip && rm crysense.zip
WORKDIR /home/user/crysense
RUN pip install --no-cache-dir -r requirements.txt gunicorn
EXPOSE 7860
CMD ["gunicorn","-b","0.0.0.0:7860","-w","1","--timeout","120","--chdir","app","app:app"]
